{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/govtechnl/onegov3-inkooptafel/data/schemas/sources.schema.json",
  "title": "Source catalogue",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "origin", "url"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["nl-law", "eu-law", "eu-framework", "framework", "policy", "guidance", "practice", "dataset", "procurement"]
          },
          "origin": {"enum": ["icbr-werksessie", "challenge-brief", "team"]},
          "url": {"type": ["string", "null"], "pattern": "^https?://"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
