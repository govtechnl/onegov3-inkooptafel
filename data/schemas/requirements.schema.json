{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/govtechnl/onegov3-inkooptafel/data/schemas/requirements.schema.json",
  "title": "Requirement library",
  "description": "A library of procurement requirements, each with the SEAL levels it belongs to and the scope conditions under which it applies. Starter format: teams may extend it.",
  "type": "object",
  "required": ["requirements"],
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "levels", "type", "text", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "levels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["SEAL-1", "SEAL-2", "SEAL-3", "SEAL-4"]}
          },
          "sov": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["SOV-1", "SOV-2", "SOV-3", "SOV-4", "SOV-5", "SOV-6", "SOV-7", "SOV-8"]}
          },
          "type": {"enum": ["eis", "gunningscriterium"]},
          "title": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "applies_when": {
            "description": "Scope conditions. The requirement applies only if every listed flag has the given value in the scope. Empty or absent: always applies at its levels.",
            "type": "object",
            "additionalProperties": {"type": "boolean"}
          },
          "rationale": {"type": "string"},
          "source": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
        }
      }
    }
  }
}
