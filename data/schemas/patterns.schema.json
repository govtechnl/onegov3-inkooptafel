{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/govtechnl/onegov3-inkooptafel/data/schemas/patterns.schema.json",
  "title": "Classification patterns with advised sovereignty level and requirements",
  "type": "object",
  "required": ["patterns"],
  "additionalProperties": false,
  "properties": {
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kritikaliteit", "gegevensclassificatie", "sovereignty_level", "rationale", "requirements"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "kritikaliteit": {"type": "string"},
          "gegevensclassificatie": {"type": "string"},
          "sovereignty_level": {"type": ["string", "null"]},
          "rationale": {"type": ["string", "null"]},
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "text", "source"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "type": {"enum": ["eis", "gunningscriterium"]},
                "text": {"type": "string", "minLength": 1},
                "source": {"type": "string"},
                "notes": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
